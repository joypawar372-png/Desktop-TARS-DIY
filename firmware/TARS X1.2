#include <WiFi.h>
#include <WebServer.h>
#include <ESP32Servo.h>
#include <ArduinoJson.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

// --- Configuration ---
const char* ssid = "YOUR_WIFI_SSID";
const char* password = "YOUR_WIFI_PASSWORD";

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, -1);

Servo leftLeg;
Servo rightLeg;
const int leftServoPin = 18;
const int rightServoPin = 19;

WebServer server(80);

void setup() {
  Serial.begin(115200);
  
  // Initialize Servos
  leftLeg.attach(leftServoPin);
  rightLeg.attach(rightServoPin);
  leftLeg.write(90); // Neutral position
  rightLeg.write(90);

  // Initialize OLED
  if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println(F("SSD1306 allocation failed"));
    for(;;);
  }
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(WHITE);
  display.setCursor(0, 10);
  display.println("TARS Initializing...");
  display.display();

  // Connect to Wi-Fi
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nConnected! IP: " + WiFi.localIP().toString());
  
  updateDisplay("ONLINE\nIP: " + WiFi.localIP().toString());

  // Set up HTTP endpoint
  server.on("/command", HTTP_POST, handleCommand);
  server.begin();
}

void loop() {
  server.handleClient();
}

void updateDisplay(String text) {
  display.clearDisplay();
  display.setCursor(0, 10);
  display.println(text);
  display.display();
}

// Basic movement logic (placeholder - adjust angles for your physical build)
void moveTars(String direction, int steps) {
  for(int i = 0; i < steps; i++) {
    if (direction == "forward") {
      leftLeg.write(120); rightLeg.write(60); delay(300);
      leftLeg.write(90); rightLeg.write(90); delay(300);
    } else if (direction == "left") {
      leftLeg.write(90); rightLeg.write(60); delay(300);
      leftLeg.write(90); rightLeg.write(90); delay(300);
    } // Add 'right' and 'backward' logic as needed
  }
}

void handleCommand() {
  if (server.hasArg("plain") == false) {
    server.send(400, "text/plain", "Body not received");
    return;
  }
  
  String body = server.arg("plain");
  StaticJsonDocument<1024> doc;
  DeserializationError error = deserializeJson(doc, body);

  if (error) {
    server.send(400, "text/plain", "Invalid JSON");
    return;
  }

  // Handle OLED Text
  if (doc.containsKey("text")) {
    String textToDisplay = doc["text"];
    updateDisplay(textToDisplay);
  }

  // Handle Movements
  if (doc.containsKey("sequence")) {
    JsonArray sequence = doc["sequence"];
    for (JsonObject step : sequence) {
      String dir = step["direction"];
      int steps = step["steps"];
      moveTars(dir, steps);
    }
  }

  server.send(200, "text/plain", "Command Executed");
}

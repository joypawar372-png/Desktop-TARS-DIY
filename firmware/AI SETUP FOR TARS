def read_local_file(filename_query):
    """Searches PC directories for the requested file and reads its content."""
    query = filename_query.replace("dot", ".").replace(" ", "").lower()
    search_dirs = [
        os.getcwd(), 
        os.path.expanduser("~\\Desktop"), 
        os.path.expanduser("~\\Documents"), 
        os.path.expanduser("~\\Downloads")
    ]
    
    for d in search_dirs:
        if not os.path.exists(d): continue
        for f in os.listdir(d):
            if query in f.lower() and f.endswith(('.txt', '.py', '.ino', '.json', '.md', '.csv')):
                try:
                    with open(os.path.join(d, f), 'r', encoding='utf-8') as file:
                        content = file.read(2000) # Cap at 2000 chars to avoid overwhelming the LLM
                        return f"Found {f}. Contents: {content}"
                except Exception as e:
                    return f"Found {f} but encountered an access error: {e}"
                    
    return f"Negative. Could not locate any text-based file matching '{filename_query}' in your core directories."

def fetch_live_info(query):
    print(f"[SEARCH] Fetching live web info for: '{query}'")
    if not HAS_DDG: return "Search engine module missing."
    try:
        results = list(DDGS().text(query, max_results=3))
        if results:
            snippets = " ".join([r.get('body', '') for r in results])
            return snippets[:600]
    except Exception as e: print(f"[SEARCH ERROR]: {e}")
    return "Unable to retrieve live data."


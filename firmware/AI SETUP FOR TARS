def tool_manage_schedule(action, text="", time_str=""):
    print(f"[TOOL] Schedule Manager: {action} | {text} | {time_str}")
    if action == "add_reminder":
        cursor.execute("INSERT INTO reminders (task, time_str) VALUES (?, ?)", (text, time_str))
        conn.commit()
        return f"Reminder saved: {text} at {time_str}."
    elif action == "get_reminders":
        cursor.execute("SELECT task, time_str FROM reminders")
        rows = cursor.fetchall()
        if not rows: return "You have no saved reminders."
        return "Reminders: " + ", ".join([f"{r[0]} at {r[1]}" for r in rows])
    elif action == "add_event":
        cursor.execute("INSERT INTO calendar (event, date_str) VALUES (?, ?)", (text, time_str))
        conn.commit()
        return f"Calendar event saved: {text} on {time_str}."
    elif action == "get_events":
        cursor.execute("SELECT event, date_str FROM calendar")
        rows = cursor.fetchall()
        if not rows: return "Your calendar is clear."
        return "Calendar Events: " + ", ".join([f"{r[0]} on {r[1]}" for r in rows])
    return "Action not recognized."


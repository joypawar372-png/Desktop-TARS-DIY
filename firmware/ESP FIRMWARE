void setupAudio() {
    // Microphone (INMP441 - RX) Configuration
    i2s_config_t i2s_mic_config = {
        .mode = (i2s_mode_t)(I2S_MODE_MASTER | I2S_MODE_RX),
        .sample_rate = 16000,
        .bits_per_sample = I2S_BITS_PER_SAMPLE_16BIT,
        .channel_format = I2S_CHANNEL_FMT_ONLY_LEFT,
        .communication_format = I2S_COMM_FORMAT_STAND_I2S,
        .intr_alloc_flags = ESP_INTR_FLAG_LEVEL1,
        .dma_buf_count = 8,
        .dma_buf_len = 512,
        .use_apll = false,
        .tx_desc_auto_clear = false,
        .fixed_mclk = 0
    };
    i2s_pin_config_t mic_pin_config = {
        .bck_io_num = I2S_MIC_BCLK,
        .ws_io_num = I2S_MIC_LRC,
        .data_out_num = I2S_PIN_NO_CHANGE,
        .data_in_num = I2S_MIC_DOUT
    };
    i2s_driver_install(I2S_NUM_0, &i2s_mic_config, 0, NULL);
    i2s_set_pin(I2S_NUM_0, &mic_pin_config);

    // Speaker (MAX98357A - TX) Configuration
    i2s_config_t i2s_spk_config = {
        .mode = (i2s_mode_t)(I2S_MODE_MASTER | I2S_MODE_TX),
        .sample_rate = 16000,
        .bits_per_sample = I2S_BITS_PER_SAMPLE_16BIT,
        .channel_format = I2S_CHANNEL_FMT_ONLY_LEFT,
        .communication_format = I2S_COMM_FORMAT_STAND_I2S,
        .intr_alloc_flags = ESP_INTR_FLAG_LEVEL1,
        .dma_buf_count = 8,
        .dma_buf_len = 512,
        .use_apll = false,
        .tx_desc_auto_clear = true,
        .fixed_mclk = 0
    };
    i2s_pin_config_t spk_pin_config = {
        .bck_io_num = I2S_SPK_BCLK,
        .ws_io_num = I2S_SPK_LRC,
        .data_out_num = I2S_SPK_DIN,
        .data_in_num = I2S_PIN_NO_CHANGE
    };
    i2s_driver_install(I2S_NUM_1, &i2s_spk_config, 0, NULL);
    i2s_set_pin(I2S_NUM_1, &spk_pin_config);

    // Start UDP Listeners on Audio Ports
    udpMic.begin(8889);
    udpSpk.begin(8890); 

    // Pin Audio Processing heavily to Core 1 to prevent interrupting Wi-Fi/Kinematics on Core 0
    xTaskCreatePinnedToCore(audioMicTask, "MicTask", 4096, NULL, 3, NULL, 1);
    xTaskCreatePinnedToCore(audioSpkTask, "SpkTask", 4096, NULL, 3, NULL, 1);
}

void audioMicTask(void * pvParameters) {
    uint8_t buffer[1024]; 
    size_t bytesIn = 0;
    while(true) {
        i2s_read(I2S_NUM_0, &buffer, sizeof(buffer), &bytesIn, portMAX_DELAY);
        // Only broadcast microphone data if we know where the Python Brain is
        if (pythonIpKnown && bytesIn > 0) {
            udpMic.beginPacket(pythonIP, 8889); 
            udpMic.write(buffer, bytesIn); 
            udpMic.endPacket();
        }
        vTaskDelay(pdMS_TO_TICKS(1)); // Watchdog yield
    }
}

void audioSpkTask(void * pvParameters) {
    uint8_t buffer[1024];
    while(true) {
        int packetSize = udpSpk.parsePacket();
        if (packetSize) {
            int len = udpSpk.read(buffer, sizeof(buffer)); 
            size_t bytesOut = 0;
            i2s_write(I2S_NUM_1, &buffer, len, &bytesOut, portMAX_DELAY);
        } else { 
            vTaskDelay(pdMS_TO_TICKS(5)); // Rest CPU if no audio is streaming
        }
    }
}


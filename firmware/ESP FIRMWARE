// =========================================================================
// 3. PERSISTENT MEMORY & SERVO KINEMATICS
// =========================================================================
void loadNVSConfig() {
  prefs.begin("tars_cfg", true);
  config.legSwingAngle    = prefs.getInt("legSwing", 5);
  config.bodyPushAngle    = prefs.getInt("bodyPush", 19);
  config.pitchLiftAngle   = prefs.getInt("pitchLift", 1);
  config.swingDuration    = prefs.getInt("swingDur", 560);
  config.pushDuration     = prefs.getInt("pushDur", 620);
  config.transitionPause  = prefs.getInt("transPause", 250);
  config.leftLegTrim      = prefs.getInt("leftTrim", 92);
  config.rightLegTrim     = prefs.getInt("rightTrim", 92);
  config.invertLeftServo  = prefs.getBool("invertLeft", false);
  config.invertRightServo = prefs.getBool("invertRight", false);
  prefs.end();
}

void saveNVSConfig() {
  prefs.begin("tars_cfg", false);
  prefs.putInt("legSwing", config.legSwingAngle);
  prefs.putInt("bodyPush", config.bodyPushAngle);
  prefs.putInt("pitchLift", config.pitchLiftAngle);
  prefs.putInt("swingDur", config.swingDuration);
  prefs.putInt("pushDur", config.pushDuration);
  prefs.putInt("transPause", config.transitionPause);
  prefs.putInt("leftTrim", config.leftLegTrim);
  prefs.putInt("rightTrim", config.rightLegTrim);
  prefs.putBool("invertLeft", config.invertLeftServo);
  prefs.putBool("invertRight", config.invertRightServo);
  prefs.end();
}

// Unified motor control ensuring inversions are respected globally
void moveServos(int leftTarget, int rightTarget) {
  if (config.invertLeftServo) {
    leftTarget = 180 - leftTarget;
  }
  if (config.invertRightServo) {
    rightTarget = 180 - rightTarget;
  }
  leftServo.write(leftTarget);
  rightServo.write(rightTarget);
}

void applyTrim() {
  moveServos(config.leftLegTrim, config.rightLegTrim);
}

// Coordinated Alternate Gait Logic
void executeGaitStep(String dir) {
  if (emergencyStop) return;
  int lTrim = config.leftLegTrim;
  int rTrim = config.rightLegTrim;
  int swing = config.legSwingAngle;
  int push = config.bodyPushAngle;

  if (dir == "FORWARD") {
    // Phase 1: Push Right (Tilt), Swing Left Forward
    moveServos(lTrim + swing, rTrim + push);
    delay(config.swingDuration);

    // Phase 2: Pull to Center
    moveServos(lTrim, rTrim);
    delay(config.transitionPause);

    // Phase 3: Push Left (Tilt), Swing Right Forward
    moveServos(lTrim + push, rTrim + swing);
    delay(config.swingDuration);

    // Phase 4: Pull to Center
    moveServos(lTrim, rTrim);
    delay(config.transitionPause);
  } 
  else if (dir == "LEFT") {
    // Steer left: Swing right leg wide, drag left leg
    moveServos(lTrim, rTrim + swing);
    delay(config.swingDuration);
    moveServos(lTrim, rTrim);
    delay(config.transitionPause);
  }
  else if (dir == "RIGHT") {
    // Steer right: Swing left leg wide, drag right leg
    moveServos(lTrim + swing, rTrim);
    delay(config.swingDuration);
    moveServos(lTrim, rTrim);
    delay(config.transitionPause);
  }
}

void executeDeskNudge(String type) {
  if (emergencyStop) return;
  int lTrim = config.leftLegTrim;
  int rTrim = config.rightLegTrim;

  if (type == "PUSH_LEFT") {
    moveServos(lTrim + 8, rTrim);
    delay(120);
    applyTrim();
  } else if (type == "PUSH_RIGHT") {
    moveServos(lTrim, rTrim + 8);
    delay(120);
    applyTrim();
  }
}

// =========================================================================
// 4. ALIGNED 0.96" OLED PARSER
// =========================================================================
void renderOledDisplay(String payload) {
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);

  int lineIdx = 0;
  int startPos = 0;
  int endPos = payload.indexOf('|');

  while (lineIdx < 4) {
    String lineText = "";
    if (endPos != -1) {
      lineText = payload.substring(startPos, endPos);
      startPos = endPos + 1;
      endPos = payload.indexOf('|', startPos);
    } else {
      lineText = payload.substring(startPos);
    }

    display.setCursor(0, lineIdx * 15);
    display.print(lineText);
    lineIdx++;

    if (endPos == -1 && startPos >= payload.length()) break;
  }
  display.display();
}

// =========================================================================
// 5. SETUP & MAIN EXECUTION LOOP
// =========================================================================
void setup() {
  Serial.begin(115200);

  leftServo.attach(LEFT_SERVO_PIN);
  rightServo.attach(RIGHT_SERVO_PIN);

  loadNVSConfig();
  applyTrim();

  Wire.begin(OLED_SDA, OLED_SCL);
  if (display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    renderOledDisplay("TARS KINEMATICS|NVS Cfg Loaded|IP: Connecting...|Standby");
  }

  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\n[SYSTEM] TARS IP: " + WiFi.localIP().toString());
  renderOledDisplay("TARS ONLINE|IP: " + WiFi.localIP().toString() + "|Ready, Chief.|Standby");

  // Web routes
  server.on("/", HTTP_GET, []() { server.send(200, "text/html", DASHBOARD_HTML); });
  
  server.on("/joy", HTTP_GET, []() { 
    currentJoystickDir = server.arg("dir"); 
    server.send(200, "text/plain", "OK"); 
  });

  server.on("/get_config", HTTP_GET, []() {
    String json = "{";
    json += "\"legSwing\":" + String(config.legSwingAngle) + ",";
    json += "\"bodyPush\":" + String(config.bodyPushAngle) + ",";
    json += "\"pitchLift\":" + String(config.pitchLiftAngle) + ",";
    json += "\"swingDur\":" + String(config.swingDuration) + ",";
    json += "\"pushDur\":" + String(config.pushDuration) + ",";
    json += "\"transPause\":" + String(config.transitionPause) + ",";
    json += "\"leftTrim\":" + String(config.leftLegTrim) + ",";
    json += "\"rightTrim\":" + String(config.rightLegTrim) + ",";
    json += "\"invertLeft\":" + String(config.invertLeftServo ? "true" : "false") + ",";
    json += "\"invertRight\":" + String(config.invertRightServo ? "true" : "false");
    json += "}";
    server.send(200, "application/json", json);
  });

  server.on("/update", HTTP_GET, []() {
    String key = server.arg("key");
    int val = server.arg("val").toInt();
    if (key == "legSwing") config.legSwingAngle = val;
    else if (key == "bodyPush") config.bodyPushAngle = val;
    else if (key == "pitchLift") config.pitchLiftAngle = val;
    else if (key == "swingDur") config.swingDuration = val;
    else if (key == "pushDur") config.pushDuration = val;
    else if (key == "transPause") config.transitionPause = val;
    else if (key == "leftTrim") { config.leftLegTrim = val; applyTrim(); }
    else if (key == "rightTrim") { config.rightLegTrim = val; applyTrim(); }
    else if (key == "invertLeft") { config.invertLeftServo = (val == 1); applyTrim(); }
    else if (key == "invertRight") { config.invertRightServo = (val == 1); applyTrim(); }
    server.send(200, "text/plain", "OK");
  });

  server.on("/save", HTTP_GET, []() { saveNVSConfig(); server.send(200, "text/plain", "Saved"); });
  server.on("/estop", HTTP_GET, []() { emergencyStop = true; applyTrim(); currentJoystickDir = "STOP"; server.send(200, "text/plain", "Stopped"); });

  server.begin();
  socketServer.begin();
}

void loop() {
  server.handleClient();

  if (currentJoystickDir != "STOP" && !emergencyStop) {
    executeGaitStep(currentJoystickDir);
  }

  WiFiClient client = socketServer.available();
  if (client) {
    while (client.connected()) {
      if (client.available()) {
        String cmd = client.readStringUntil('\n');
        cmd.trim();

        if (cmd.startsWith("DISP:")) {
          renderOledDisplay(cmd.substring(5));
        } else if (cmd.startsWith("FORWARD")) {
          executeGaitStep("FORWARD");
        } else if (cmd == "PUSH_LEFT" || cmd == "PUSH_RIGHT") {
          executeDeskNudge(cmd);
        } else if (cmd.startsWith("SET_SWING:")) {
          config.legSwingAngle = cmd.substring(10).toInt();
        }
      }
    }
    client.stop();
  }
}
